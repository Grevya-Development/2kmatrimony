# 2K Matrimony mobile — copy to .env (Expo loads EXPO_PUBLIC_* at bundle time).
# Use your machine's LAN IP for physical devices; Android emulator can use 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Product analytics (optional; consent-gated). Same PostHog project as web.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
