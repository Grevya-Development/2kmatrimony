# ---------------------------------------------------------------------------
# 2K Marriage — web/API environment. Copy to .env.local and fill in.
# Variables marked OPTIONAL enable integrations; the app runs without them and
# reports the integration as "unconfigured" (see docs/INTEGRATIONS.md).
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required). Local values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron / internal jobs (required in production): random 32+ char string
CRON_SECRET=

# AI — Anthropic (OPTIONAL; AI features fall back to engine output when unset)
ANTHROPIC_API_KEY=
# Embeddings — Voyage AI (OPTIONAL; search falls back to Postgres full-text)
VOYAGE_API_KEY=

# Payments — Razorpay (OPTIONAL; checkout disabled when unset)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email — Resend (OPTIONAL)
RESEND_API_KEY=
EMAIL_FROM="2K Marriage <no-reply@example.com>"

# SMS — MSG91 (OPTIONAL; DLT-registered templates required in India)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# WhatsApp — Meta Cloud API (OPTIONAL)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Product analytics — PostHog (OPTIONAL; consent-gated, see docs/INTEGRATIONS.md)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Push — Expo push service (OPTIONAL access token for enhanced security)
EXPO_ACCESS_TOKEN=
